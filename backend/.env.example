DEBUG=false
SECRET_KEY=your-secret-key-here

DATABASE_URL=mysql+aiomysql://vbots:vbots@mysql:3306/vbots?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://vbots:vbots@mysql:3306/vbots?charset=utf8mb4

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

LIVEKIT_URL=ws://192.168.10.30:7880
# Worker running inside Docker: ws://livekit:7880  (docker-compose overrides this automatically)
# Worker running ON the LiveKit server (no Docker): ws://127.0.0.1:7880
# WebRTC: infra/livekit.yaml rtc.node_ip must equal the server LAN IP; open UDP 50000-60000
#
# IMPORTANT: LIVEKIT_API_KEY + LIVEKIT_API_SECRET must match infra/livekit.yaml keys: section
# Example livekit.yaml:
#   keys:
#     APIvoicebot: your-api-secret-here
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Must match Worker registration name (agent_name= in WorkerOptions)
LIVEKIT_AGENT_NAME=vbots

# Outbound SIP trunk LiveKit ID — set after SIP Trunks → Sync from LiveKit
# Skips DB lookup for every outbound dial (faster, more reliable)
# LIVEKIT_OUTBOUND_TRUNK_ID=ST_xxxx

# Call recordings — built-in session recorder (session.start record=audio)
RECORDINGS_PATH=data/recordings
VBOT_RECORDING_ENABLED=true
# Stale rows on Live Calls page (seconds)
# LIVE_CALL_RINGING_MAX_SECONDS=300
# LIVE_CALL_ACTIVE_MAX_SECONDS=1800

# Voice agent (optional — defaults match working vbot script)
# AGENT_STT_MODEL=saaras:v3
# AGENT_TTS_MODEL=bulbul:v3
# AGENT_AUDIO_SAMPLE_RATE=8000
# AGENT_PREEMPTIVE_GENERATION=false
# AGENT_MIN_ENDPOINTING_DELAY=0.42
# AGENT_MAX_ENDPOINTING_DELAY=2.5

OPENAI_API_KEY=
SARVAM_API_KEY=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

VICIDIAL_WEBHOOK_SECRET=

# CORS — add production server IP so browser can reach the API
# CORS_ORIGINS=http://192.168.10.30,http://192.168.10.30:8000,http://localhost:5173
